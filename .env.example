# Read by docker-compose.yml. Copy to .env.
#
# These are local-development credentials. Nothing here is deployed, and the
# apps never read this file — they read DATABASE_URL (see packages/database/.env
# and apps/api/.env, which scripts/check-db-env.mjs keeps in agreement).
DB_NAME=app
DB_USER=app
DB_PASSWORD=app

# Command Code API key for the e2e agent model. e2e.config.ts loads this file
# itself (process.loadEnvFile) because the runner reads no .env of its own.
# Create one in Studio → API keys (commandcode.ai/settings/keys); every plan
# except Go has Provider API access. Local only, never deployed.
CMD_API_KEY=
