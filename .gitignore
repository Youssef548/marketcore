node_modules/
dist/
.next/
.turbo/
coverage/
*.tsbuildinfo

# Mutation testing: Stryker's scratch copy of the sources, and its report output.
# The report is regenerated per run and is read in CI output, not committed.
.stryker-tmp/
reports/

# Playwright's run state and its HTML report.
apps/e2e/test-results/
apps/e2e/playwright-report/
.env
.env.*
!.env.example
# Regenerated by `next typegen` (which `typecheck` runs first).
apps/web/next-env.d.ts
.idea/
*.iml
.DS_Store

# Scratch workspace for subagent-driven plan execution: per-plan ledgers, task
# briefs, implementer reports and review packages. Working state, not deliverables.
.superpowers/
.e2e/artifacts/
.e2e/cache/
.e2e/sessions/
.e2e/report.json
.e2e/ai-trace.json
.e2e/junit.xml
.e2e/summary.md
.e2e/failures/
.e2e/logs/
.e2e/videos/

# Local agent tooling. These are per-machine installs, not project source — but the repository
# does track seven skills of its own, so the rule is "ignore skill directories, re-include the
# ones this repository owns" rather than "ignore .agents/". A blanket directory ignore would
# hide a future change to a skill that *is* committed.
.agents/skills/*/
!.agents/skills/e2e/
!.agents/skills/git-delivery-workflow/
!.agents/skills/nestjs-code-conventions/
!.agents/skills/phase-loop/
!.agents/skills/ship-task/
!.agents/skills/small-stacked-prs/
!.agents/skills/typescript-code-conventions/

# The delegate fleet's own installs, and the machinery around them.
.claude/worktrees/
.commandcode/taste/
.playwright-mcp/
skills-lock.json

# Rendered exports. The 31 diagrams this repository tracks are SVG; a PNG is a render of the
# .excalidraw source beside it, so the source is what belongs in git.
docs/superpowers/*.png
