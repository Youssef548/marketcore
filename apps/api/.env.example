# Copy to .env. The API refuses to boot if any of these are missing or invalid.
APP_NAME=marketcore

# Must match DATABASE_URL in packages/database/.env — scripts/check-db-env.mjs
# fails the migrate commands when they disagree.
DATABASE_URL=postgresql://app:app@localhost:5432/app

PORT=3001
# Comma-separated list of allowed browser origins.
WEB_URL=http://localhost:3000

# Signs access tokens. Must be at least 32 characters — the API refuses to boot
# with a short one, because a weak signing secret is a forgery risk no
# downstream check can repair.
JWT_SECRET=replace-me-with-at-least-32-characters
