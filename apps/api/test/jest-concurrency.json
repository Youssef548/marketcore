{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "testEnvironment": "node",
  "testRegex": ".concurrency-spec.ts$",
  "transform": { "^.+\\.(t|j)s$": "ts-jest" },
  "setupFiles": ["dotenv/config"],
  "moduleNameMapper": {
    "^@app/(.*)$": "<rootDir>/../../packages/$1/src/index.ts"
  }
}
