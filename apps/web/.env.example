# Copy to .env.
#
# Read on the server (layout metadata, app/manifest.ts). Renaming the project
# means changing this and the root package.json name — nothing else.
APP_NAME=app

# Where the API is. The `/api/v1` prefix is NOT part of this value: it is appended
# in src/lib/api/config.ts from the constant in @app/contracts, which the API also
# reads its own prefix from.
API_BASE_URL=http://localhost:3001

# Marks the session cookies `Secure`. Off here because a developer serves plain
# http on localhost, and a browser silently drops a `Secure` cookie sent over http
# — which fails as "signed out at random" rather than as an error. The behavioural
# stack runs the built app over real TLS and sets it to true, which is the only
# place that branch can be exercised.
SESSION_COOKIE_SECURE=false
