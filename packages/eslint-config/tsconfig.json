{
  "extends": "@app/config/tsconfig/base.json",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "composite": false,
    // base.json turns declarations on so published packages ship types. This
    // package is private and emits nothing, and leaving it on makes tsc try to
    // name the inferred type of the exported factory (TS2742).
    "declaration": false,
    "declarationMap": false,
    "types": ["node"]
  },
  // `test` is the boundary tests. `test/fixtures` is deliberately excluded: it is a
  // miniature workspace of files that exist to be *linted* — including one `.tsx`
  // component, which the linter must parse and this package has no JSX compiler options
  // for, and one file that imports a module that does not exist, which is the point of it.
  // Typechecking them would assert the opposite of what they are for.
  "include": ["test", "index.js"],
  "exclude": ["test/fixtures"]
}
