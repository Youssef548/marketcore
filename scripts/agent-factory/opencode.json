{
  "$schema": "https://opencode.ai/config.json",
  "share": "disabled",
  "permission": {
    "*": "allow",
    "question": "deny",
    "doom_loop": "deny",
    "external_directory": "deny",
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    "edit": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny"
    },
    "bash": {
      "*": "allow",
      "git push": "deny",
      "git push *": "deny",
      "git remote *": "deny",
      "git config *": "deny",
      "git credential *": "deny",
      "git reset --hard*": "deny",
      "git clean *": "deny",
      "git switch *": "deny",
      "git checkout main*": "deny",
      "git worktree *": "deny",
      "git branch -D *": "deny",
      "git branch -d *": "deny",
      "git tag *": "deny",
      "git update-ref *": "deny",
      "git filter-branch *": "deny",
      "gh": "deny",
      "gh *": "deny",
      "security *": "deny",
      "ssh *": "deny",
      "scp *": "deny",
      "sudo *": "deny",
      "docker": "deny",
      "docker *": "deny",
      "docker-compose *": "deny",
      "launchctl *": "deny",
      "crontab *": "deny",
      "npm publish*": "deny",
      "pnpm publish*": "deny",
      "opencode *": "deny",
      "claude *": "deny",
      "rm -rf /*": "deny",
      "rm -rf ~*": "deny",
      "rm -rf $HOME*": "deny"
    }
  }
}
